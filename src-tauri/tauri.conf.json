{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileM",
  "version": "0.1.11",
  "identifier": "local.filem.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:5178",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FileM · 文件聚合工作台",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "按类型聚合本地文件",
    "category": "Utility",
    "resources": {
      "../src/assets/file-icons/LICENSE.txt": "licenses/material-icon-theme-MIT.txt",
      "../src/assets/file-icons/SOURCE.md": "licenses/material-icon-theme-source.md",
      "../crates/filem-core/vendor/everything/LICENSE.txt": "licenses/everything-sdk-MIT.txt",
      "../crates/filem-core/vendor/everything/SOURCE.md": "licenses/everything-sdk-source.md",
      "licenses/THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt"
    }
  }
}
