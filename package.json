{
  "name": "filem",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "windows:build": "node scripts/windows-build.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:ui": "node --test scripts/test-scan-status.mjs",
    "test": "node scripts/cargo.mjs test --workspace --exclude filem-desktop",
    "check:rust": "node scripts/cargo.mjs check --workspace",
    "bench:index": "node scripts/cargo.mjs run --release -p filem-core --example benchmark"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
